{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/[workspaceId]",
      "regex": "^/admin/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPworkspaceId": "nxtPworkspaceId"
      },
      "namedRegex": "^/admin/(?<nxtPworkspaceId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/group-creation-requests/[id]",
      "regex": "^/api/group\\-creation\\-requests/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/group\\-creation\\-requests/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/groups/[id]",
      "regex": "^/api/groups/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/groups/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/groups/[id]/members",
      "regex": "^/api/groups/([^/]+?)/members(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/groups/(?<nxtPid>[^/]+?)/members(?:/)?$"
    },
    {
      "page": "/api/join-requests/[id]",
      "regex": "^/api/join\\-requests/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/join\\-requests/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/messages/[id]",
      "regex": "^/api/messages/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/messages/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/payments/notifications/[id]",
      "regex": "^/api/payments/notifications/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/payments/notifications/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/payments/subscriptions/[adminId]",
      "regex": "^/api/payments/subscriptions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPadminId": "nxtPadminId"
      },
      "namedRegex": "^/api/payments/subscriptions/(?<nxtPadminId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/users/[id]",
      "regex": "^/api/users/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/users/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/workspaces/[id]",
      "regex": "^/api/workspaces/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/workspaces/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/join/[groupSlug]",
      "regex": "^/join/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPgroupSlug": "nxtPgroupSlug"
      },
      "namedRegex": "^/join/(?<nxtPgroupSlug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/workspace/[adminId]",
      "regex": "^/workspace/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPadminId": "nxtPadminId"
      },
      "namedRegex": "^/workspace/(?<nxtPadminId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/~offline",
      "regex": "^/~offline(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/~offline(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/superadmin",
      "regex": "^/superadmin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/superadmin(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}