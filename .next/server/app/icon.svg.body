<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <!-- Background -->
  <rect width="512" height="512" rx="112" fill="#075e54"/>

  <!-- Broadcast / radio waves -->
  <circle cx="256" cy="280" r="44" fill="none" stroke="#25d366" stroke-width="28" stroke-linecap="round"/>
  <path d="M172 196 a118 118 0 0 1 168 0" fill="none" stroke="#25d366" stroke-width="28" stroke-linecap="round"/>
  <path d="M130 154 a174 174 0 0 1 252 0" fill="none" stroke="#ffffff" stroke-width="24" stroke-linecap="round" opacity="0.6"/>

  <!-- Center dot -->
  <circle cx="256" cy="280" r="18" fill="#ffffff"/>

  <!-- Signal pole -->
  <line x1="256" y1="324" x2="256" y2="390" stroke="#25d366" stroke-width="26" stroke-linecap="round"/>
  <line x1="210" y1="390" x2="302" y2="390" stroke="#25d366" stroke-width="26" stroke-linecap="round"/>
</svg>
