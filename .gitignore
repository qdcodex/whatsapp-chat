public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map
public/fallback-*.js

# Bun lock files — project uses npm for CI/Railway
bun.lock
bun.lockb

