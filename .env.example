# Database - REQUIRED for MongoDB
# Get this from MongoDB Atlas → Connect → Connection String
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/whatsapp

# Socket.io CORS - REQUIRED for production
# Set this to your Railway app URL or custom domain
# Format: https://your-app.up.railway.app
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# Server Config - Optional (Railway sets these automatically)
PORT=3000
NODE_ENV=production

# Socket.io Client URL - Optional (auto-detected from window.location.origin)
# Only set this if socket is on a different domain
# NEXT_PUBLIC_SOCKET_URL=https://your-app.up.railway.app

# Cloudinary - REQUIRED for image uploads (message photos, avatars)
# Get these from Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
